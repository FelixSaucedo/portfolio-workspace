server {
    listen 80;

    set_real_ip_from ${CADDY_PROXY_IP};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Caddy terminates HTTPS; this gateway has no published host ports.
    set $portfolio_scheme https;
    set $portfolio_https on;
    include /etc/nginx/portfolio-common.conf;

    location / {
        proxy_pass http://ui:80;
        include /etc/nginx/portfolio-proxy.conf;
        proxy_set_header Connection "";
    }
}
